{
  "_about": "PRTSCN design tokens. Original palette (not Lightshot's). The capture chrome is dark, so it reads over any screenshot. tools/gen_theme.py turns this into src/PRTSCN/Theme.g.cs. Check with: python3 contrast.py tokens.json",
  "color": {
    "bg": "#121318",
    "surface": "#1d1f26",
    "surface-active": "#2a2d36",
    "border": "#2c2f38",
    "border-input": "#7a8090",
    "text": "#f2f3f5",
    "text-muted": "#a3a8b4",
    "accent": "#ffb020",
    "on-accent": "#121318",
    "danger": "#ff6b6b",
    "success": "#3ddc97",
    "handle-fill": "#ffffff",
    "ink-default": "#ff3347"
  },
  "alpha": {
    "dim": 0.55,
    "marker": 0.42,
    "toolbar": 0.96
  },
  "ink": ["#ff3347", "#ffb020", "#ffe14d", "#3ddc97", "#33b5ff", "#8b5cf6", "#ffffff", "#121318"],
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-active"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg"],
    ["accent", "surface"],
    ["danger", "bg"],
    ["success", "bg"],
    ["border-input", "bg", "ui"],
    ["accent", "border", "ui"]
  ],
  "font": {
    "sans": "Segoe UI Variable Text, Segoe UI, sans-serif",
    "mono": "Cascadia Mono, Consolas, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 14, "weight": 600},
    "sm": {"size": 12, "line": 16, "weight": 400},
    "base": {"size": 14, "line": 20, "weight": 400},
    "lg": {"size": 18, "line": 24, "weight": 600}
  },
  "space": [0, 2, 4, 6, 8, 12, 16, 24],
  "size": {"button": 32, "icon": 18, "handle": 8, "toolbar-gap": 8, "toolbar-pad": 4},
  "radius": {"sm": 4, "md": 6, "lg": 10, "pill": 999},
  "stroke": {"icon": 1.75, "selection": 1, "default-ink": 3, "min-ink": 1, "max-ink": 24},
  "motion": {"fast": "0ms", "_note": "capture UI is instant; no animation"}
}
